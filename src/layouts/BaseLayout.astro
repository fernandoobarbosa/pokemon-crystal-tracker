---
import { spriteUrl } from '../lib/sprites';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <div class="frame">
      <header class="header">
        <img src={spriteUrl('suicune')} alt="" class="suicune-icon" />
        <div>
          <h1>Fernando's Journey</h1>
          <p class="subtitle">Pokémon Crystal Legacy: Timeless</p>
        </div>
      </header>

      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #122043;
    --panel: #16294f;
    --border: #3d5a80;
    --border-strong: #5a7ba6;
    --border-empty: #2a4066;
    --text: #dfe8f0;
    --text-dim: #8ba3c0;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: 'Courier New', Courier, monospace;
    display: flex;
    justify-content: center;
    padding: 24px 12px;
  }

  .frame {
    width: 100%;
    max-width: 640px;
    border: 2px solid var(--border);
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-bottom: 1px solid var(--border);
    background: var(--panel);
    padding: 14px;
  }

  .suicune-icon {
    width: 24px;
    height: 24px;
    image-rendering: pixelated;
    opacity: 0.9;
  }

  .header h1 {
    font-size: 15px;
    letter-spacing: 1px;
    margin: 0;
    text-align: center;
  }

  .header .subtitle {
    font-size: 9px;
    color: var(--text-dim);
    letter-spacing: 1px;
    margin: 4px 0 0;
    text-align: center;
  }

  main {
    padding: 14px;
  }

  .panel {
    border: 1px solid var(--border);
    background: var(--panel);
    padding: 10px;
    margin-bottom: 10px;
  }

  .panel-label {
    font-size: 9px;
    color: var(--text-dim);
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
</style>
