---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const TOTAL_GYMS = 8;

const badges = (await getCollection('badges')).sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout title="Insígnias — Fernando's Journey">
  <div class="badge-grid">
    {Array.from({ length: TOTAL_GYMS }).map((_, i) => {
      const badge = badges[i];
      if (!badge) {
        return <div class="badge-card empty">???</div>;
      }
      return (
        <a href={`/badges/${badge.id}`} class="badge-card earned">
          <div class="gym">{badge.data.gym}</div>
          <div class="leader">{badge.data.leader}</div>
        </a>
      );
    })}
  </div>
</BaseLayout>

<style>
  .badge-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 8px;
  }

  .badge-card {
    border: 1px solid var(--border);
    padding: 8px;
    text-align: center;
    font-size: 9px;
    text-decoration: none;
    display: block;
  }

  .badge-card.earned {
    background: var(--border-strong);
    color: var(--bg);
  }

  .badge-card.earned .leader {
    font-weight: bold;
    margin-top: 4px;
  }

  .badge-card.empty {
    border-style: dashed;
    border-color: var(--border-empty);
    color: var(--text-dim);
    opacity: 0.5;
  }
</style>
