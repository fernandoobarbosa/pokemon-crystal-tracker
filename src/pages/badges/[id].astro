---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const badges = await getCollection('badges');
  return badges.map((badge) => ({
    params: { id: badge.id },
    props: { badge },
  }));
}

interface Props {
  badge: CollectionEntry<'badges'>;
}

const { badge } = Astro.props;
const { Content } = await render(badge);
---

<BaseLayout title={`${badge.data.leader} — Insígnia`}>
  <div class="panel">
    <div class="panel-label">{badge.data.gym} · {badge.data.leader}</div>
    <img
      src={`/trainer-cards/${badge.data.trainer_card}`}
      alt={`Trainer card - ${badge.data.leader}`}
      class="trainer-card"
    />
  </div>

  <div class="panel notes">
    <Content />
  </div>

  <a href="/badges" class="back-link">← voltar às insígnias</a>
</BaseLayout>

<style>
  .trainer-card {
    display: block;
    max-width: 100%;
    border: 1px solid var(--border);
  }

  .notes {
    font-size: 12px;
    line-height: 1.6;
  }

  .back-link {
    display: inline-block;
    margin-top: 4px;
    font-size: 9px;
    color: var(--text-dim);
  }
</style>
