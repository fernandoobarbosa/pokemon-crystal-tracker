---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { spriteUrl } from '../lib/sprites';
import { capitalize } from '../lib/format';
import { groupTimelineEvents } from '../lib/timeline';

const badges = await getCollection('badges');
const events = await getCollection('timeline');
const groups = groupTimelineEvents(badges, events);
---

<BaseLayout title="Timeline — Fernando's Journey">
  {groups.length === 0 && <p class="empty-state">Nenhum evento registrado ainda.</p>}

  {groups.map((group) => (
    <Fragment>
      <div class="section-label">◆ {group.label} ◆</div>
      <div class="timeline">
        {group.events.map((event) => (
          <div class="event">
            <div class="location">{event.data.location}</div>
            <div class="event-body">
              {event.data.evolved_from && (
                <img src={spriteUrl(event.data.evolved_from)} alt={event.data.evolved_from} />
              )}
              {event.data.evolved_from && <span class="arrow">→</span>}
              <img src={spriteUrl(event.data.pokemon)} alt={event.data.pokemon} />
              <div class="desc">
                {event.data.evolved_from ? (
                  <Fragment>
                    {capitalize(event.data.evolved_from)} evoluiu para{' '}
                    <b>{capitalize(event.data.pokemon)}</b>!
                  </Fragment>
                ) : (
                  <Fragment>
                    Capturou um <b>{capitalize(event.data.pokemon)}</b>
                  </Fragment>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </Fragment>
  ))}
</BaseLayout>

<style>
  .empty-state {
    font-size: 10px;
    color: var(--text-dim);
  }

  .section-label {
    border: 1px solid var(--border);
    background: rgba(126, 232, 250, 0.06);
    padding: 6px 10px;
    margin-bottom: 10px;
    font-size: 9px;
    color: var(--text-dim);
    text-align: center;
  }

  .timeline {
    border-left: 2px solid var(--border);
    padding-left: 12px;
    margin: 0 0 16px 6px;
  }

  .event {
    margin-bottom: 14px;
    position: relative;
  }

  .event::before {
    content: '';
    position: absolute;
    left: -17px;
    top: 3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .location {
    font-size: 8px;
    color: var(--text-dim);
    margin-bottom: 4px;
    text-transform: uppercase;
  }

  .event-body {
    border: 1px solid var(--border);
    background: var(--panel);
    padding: 8px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .event-body img {
    width: 32px;
    height: 32px;
    image-rendering: pixelated;
    background: #1c3158;
    border: 1px solid var(--border);
  }

  .arrow {
    font-size: 12px;
    color: var(--text-dim);
  }

  .desc {
    font-size: 9px;
  }
</style>
