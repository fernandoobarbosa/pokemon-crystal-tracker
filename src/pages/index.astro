---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { spriteUrl } from '../lib/sprites';
import { groupTimelineEvents } from '../lib/timeline';
import teamData from '../content/team.json';

const TOTAL_GYMS = 8;

const badges = (await getCollection('badges')).sort((a, b) => a.id.localeCompare(b.id));
const events = await getCollection('timeline');
const groups = groupTimelineEvents(badges, events);

const latestBadge = badges.at(-1);
const currentStretch = groups.at(-1);
---

<BaseLayout title="Fernando's Journey — Home">
  {latestBadge && (
    <div class="panel">
      <div class="panel-label">
        Último trainer card (Insígnia {badges.length}: {latestBadge.data.leader})
      </div>
      <img
        src={`/trainer-cards/${latestBadge.data.trainer_card}`}
        alt={`Trainer card - ${latestBadge.data.leader}`}
        class="trainer-card"
      />
    </div>
  )}

  <div class="panel">
    <div class="panel-label">Insígnias ({badges.length}/{TOTAL_GYMS})</div>
    <div class="badge-row">
      {Array.from({ length: TOTAL_GYMS }).map((_, i) => (
        <div class={`badge-slot ${i < badges.length ? 'earned' : 'empty'}`} />
      ))}
    </div>
  </div>

  <div class="panel">
    <div class="panel-label">Time atual</div>
    <div class="team-row">
      {teamData.map((pokemon) => (
        <div class="team-member">
          <img src={spriteUrl(pokemon.species)} alt={pokemon.nickname ?? pokemon.species} />
          <span>
            {pokemon.nickname ?? pokemon.species} <small>Lv.{pokemon.level}</small>
          </span>
        </div>
      ))}
    </div>
  </div>

  {currentStretch && (
    <div class="panel stretch-panel">
      <div class="panel-label">Timeline · Trecho atual</div>
      <div class="stretch-label">{currentStretch.label}</div>
      <img src={spriteUrl('celebi')} alt="" class="celebi-watermark" />
    </div>
  )}
</BaseLayout>

<style>
  .trainer-card {
    display: block;
    max-width: 100%;
    border: 1px solid var(--border);
  }

  .badge-row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .badge-slot {
    width: 26px;
    height: 26px;
    border: 1px solid var(--border);
  }

  .badge-slot.earned {
    background: var(--border-strong);
  }

  .badge-slot.empty {
    background: var(--bg);
    border-style: dashed;
    border-color: var(--border-empty);
  }

  .team-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .team-member {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 9px;
    color: var(--text-dim);
    gap: 4px;
  }

  .team-member img {
    width: 40px;
    height: 40px;
    image-rendering: pixelated;
    background: #1c3158;
    border: 1px solid var(--border);
  }

  .stretch-panel {
    position: relative;
    overflow: hidden;
    margin-bottom: 0;
  }

  .stretch-label {
    font-size: 9px;
  }

  .celebi-watermark {
    position: absolute;
    right: 8px;
    bottom: 6px;
    width: 18px;
    image-rendering: pixelated;
    opacity: 0.35;
  }
</style>
