---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { spriteUrl } from '../lib/sprites';
import { capitalize } from '../lib/format';
import { groupTimelineEvents } from '../lib/timeline';
import teamData from '../content/team.json';

const TOTAL_GYMS = 8;

const badges = (await getCollection('badges')).sort((a, b) => a.id.localeCompare(b.id));
const events = await getCollection('timeline');
const groups = groupTimelineEvents(badges, events);
---

<BaseLayout title="Fernando's Journey — Home">
  <div class="panel">
    <div class="panel-label">Time atual</div>
    <div class="team-row">
      {teamData.map((pokemon) => (
        <div class="team-member">
          <img src={spriteUrl(pokemon.species)} alt={pokemon.nickname ?? pokemon.species} />
          <span>{pokemon.nickname ?? pokemon.species}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="panel">
    <div class="panel-label">Insígnias ({badges.length}/{TOTAL_GYMS})</div>
    <div class="badge-row">
      {Array.from({ length: TOTAL_GYMS }).map((_, i) => {
        const badge = badges[i];
        if (!badge) {
          return <div class="badge-slot empty">???</div>;
        }
        return (
          <div class="badge-slot earned">
            <img src={`/badges/${badge.data.badge_icon}.png`} alt={badge.data.leader} />
            <span>{badge.data.leader}</span>
          </div>
        );
      })}
    </div>
  </div>

  <div class="panel-label" style="padding: 0 4px;">Eventos</div>
  {groups.length === 0 && <p class="empty-state">Nenhum evento registrado ainda.</p>}
  {groups.map((group) => (
    <Fragment>
      <div class="section-label">◆ {group.label} ◆</div>
      <div class="timeline">
        {group.events.map((event) => (
          <div class="event">
            <div class="location">{event.data.location}</div>
            <div class="event-body">
              {event.data.evolved_from && (
                <img src={spriteUrl(event.data.evolved_from)} alt={event.data.evolved_from} />
              )}
              {event.data.evolved_from && <span class="arrow">→</span>}
              <img src={spriteUrl(event.data.pokemon)} alt={event.data.pokemon} />
              <div class="desc">
                {event.data.label ? (
                  event.data.label
                ) : event.data.evolved_from ? (
                  <Fragment>
                    {capitalize(event.data.evolved_from)} evoluiu para{' '}
                    <b>{capitalize(event.data.pokemon)}</b>!
                  </Fragment>
                ) : (
                  <Fragment>
                    Capturou um <b>{capitalize(event.data.pokemon)}</b>
                  </Fragment>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </Fragment>
  ))}
</BaseLayout>

<style>
  .badge-row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .badge-slot {
    width: 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 6px 4px;
    border: 1px solid var(--border);
    font-size: 8px;
    text-align: center;
  }

  .badge-slot.earned {
    background: var(--border-strong);
    color: var(--bg);
  }

  .badge-slot.earned img {
    width: 20px;
    height: 20px;
    image-rendering: pixelated;
  }

  .badge-slot.empty {
    background: var(--bg);
    border-style: dashed;
    border-color: var(--border-empty);
    color: var(--text-dim);
    opacity: 0.6;
  }

  .empty-state {
    font-size: 10px;
    color: var(--text-dim);
  }

  .section-label {
    border: 1px solid var(--border);
    background: rgba(126, 232, 250, 0.06);
    padding: 6px 10px;
    margin-bottom: 10px;
    font-size: 9px;
    color: var(--text-dim);
    text-align: center;
  }

  .timeline {
    border-left: 2px solid var(--border);
    padding-left: 12px;
    margin: 0 0 16px 6px;
  }

  .event {
    margin-bottom: 14px;
    position: relative;
  }

  .event::before {
    content: '';
    position: absolute;
    left: -17px;
    top: 3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .location {
    font-size: 8px;
    color: var(--text-dim);
    margin-bottom: 4px;
    text-transform: uppercase;
  }

  .event-body {
    border: 1px solid var(--border);
    background: var(--panel);
    padding: 8px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .event-body img {
    width: 32px;
    height: 32px;
    image-rendering: pixelated;
    background: #1c3158;
    border: 1px solid var(--border);
  }

  .arrow {
    font-size: 12px;
    color: var(--text-dim);
  }

  .desc {
    font-size: 9px;
  }
</style>
